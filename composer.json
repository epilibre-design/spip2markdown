{
    "name": "epilibre/spip2markdown",
    "description": "Convertisseur SPIP → Markdown",
    "type": "spip-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "tests-unit": "vendor/bin/phpunit --colors --testsuite unit"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
